{
  "name": "skimgram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Surprisal-based skim reading for the web. No AI model download.",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "predev": "node scripts/gen-icons.mjs",
    "dev": "wxt",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "wxt build",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "prezip": "node scripts/gen-icons.mjs",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "wxt build && node scripts/smoke.mjs",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "0.2.7",
    "@types/node": "22.20.1",
    "hanzi": "3.2.0",
    "jsdom": "30.0.1",
    "most-common-words-by-language": "3.0.14",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
